@model PurchaseOrderManagementSystem.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-md">
        <div class="bg-white shadow rounded-lg px-8 py-6">
            <div class="text-center mb-6">
                <h1 class="text-2xl font-bold text-gray-900">Change Password</h1>
                <p class="text-gray-600">Please set a new password for your account</p>
            </div>
            <form asp-action="ChangePassword" method="post" class="space-y-4">
                <input type="hidden" asp-for="UserId" />
                <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

                <div>
                    <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="NewPassword" type="password" class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" required />
                    <span asp-validation-for="NewPassword" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="ConfirmPassword" type="password" class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" required />
                    <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md text-sm font-medium">
                    Change Password
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 
