@{
    ViewData["Title"] = "Reset Password Confirmation";
    Layout = "_Layout";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-md">
        <div class="bg-white shadow rounded-lg px-8 py-6">
            <div class="text-center mb-6">
                <h1 class="text-2xl font-bold text-gray-900">Reset Password Confirmation</h1>
                <p class="text-gray-600">Your password has been reset. Please <a href="@Url.Action("Login", "Account")" class="text-blue-600 hover:underline">click here to log in</a>.</p>
            </div>
        </div>
    </div>
</div>

