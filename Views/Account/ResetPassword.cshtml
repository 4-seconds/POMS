@model PurchaseOrderManagementSystem.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset password";
    Layout = "_Layout";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-md">
        <div class="bg-white shadow rounded-lg px-8 py-6">
            <div class="text-center mb-6">
                <h1 class="text-2xl font-bold text-gray-900">Reset your password</h1>
                <p class="text-gray-600">Enter your email and new password.</p>
            </div>
            <form method="post" asp-action="ResetPassword" class="space-y-4">
                <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

                <input type="hidden" asp-for="Code" />

                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Email" type="email" placeholder="Enter your email"
                           class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"
                           required />
                    <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Password" type="password" placeholder="Enter your new password"
                           class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"
                           required />
                    <span asp-validation-for="Password" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm your new password"
                           class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"
                           required />
                    <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
                </div>

                <button type="submit"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md text-sm font-medium">
                    Reset
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

