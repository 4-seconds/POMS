@model PurchaseOrderManagementSystem.Models.Auction

@{
    ViewData["Title"] = "Procurement Officer - Edit Auction Deadlines";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50">
    <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center py-4">
                <a href="/ProcurementOfficer/ViewAuction/@Model.Id"
                   class="inline-flex items-center bg-transparent hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Back to Auction Details
                </a>
                <h1 class="text-2xl font-bold text-gray-900 ml-4">Edit Auction Deadlines</h1>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
            <div class="bg-white shadow rounded-lg">
                <div class="border-b px-4 py-3">
                    <h2 class="text-lg font-semibold text-gray-800">Auction Details</h2>
                </div>
                <div class="p-6 space-y-4">
                    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-8">
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Item Name</dt>
                            <dd class="mt-1 text-lg text-gray-900">@Model.PurchaseRequest?.existingItem?.ItemName</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Quantity</dt>
                            <dd class="mt-1 text-lg text-gray-900">@Model.PurchaseRequest?.quantity</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Current Auction End Date</dt>
                            <dd class="mt-1 text-lg text-gray-900">@Model.EndDate.ToString("yyyy-MM-dd HH:mm")</dd>
                        </div>
                        <div class="sm:col-span-1">
                            <dt class="text-sm font-medium text-gray-500">Current Delivery Deadline</dt>
                            <dd class="mt-1 text-lg text-gray-900">@Model.DeliveryDeadline.ToString("yyyy-MM-dd")</dd>
                        </div>
                    </dl>

                    <div class="mt-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Update Auction Deadlines</h3>
                        <form asp-action="EditAuctionDeadlines" method="post" class="space-y-4">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div>
                                <label for="auctionEndDate" class="block text-sm font-medium text-gray-700">New Auction End Date</label>
                                <input type="datetime-local" id="auctionEndDate" name="auctionEndDate" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")"
                                       class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" required />
                            </div>
                            <div>
                                <label for="deliveryDeadline" class="block text-sm font-medium text-gray-700">New Delivery Deadline</label>
                                <input type="date" id="deliveryDeadline" name="deliveryDeadline" value="@Model.DeliveryDeadline.ToString("yyyy-MM-dd")"
                                       class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" required />
                            </div>
                            <button type="submit"
                                    class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md text-sm font-medium">
                                Update Deadlines
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

