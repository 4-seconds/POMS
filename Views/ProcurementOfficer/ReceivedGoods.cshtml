@model IEnumerable<PurchaseOrderManagementSystem.Models.GoodsReceived>

@{
    ViewData["Title"] = "Received Goods";
}

<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="py-4">
        <div class="py-4 flex gap-5 items-center">
          <a asp-action="Index" class="text-blue-600 hover:text-blue-900 font-medium">Back</a>
          <h1 class="text-2xl font-bold text-gray-900">Received Goods</h1>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto py-2 sm:px-6 lg:px-8">
      <div class="px-4 py-2 sm:px-0">
        <div class="container mx-auto px-4 py-4">
            <table class="min-w-full divide-y divide-gray-200 shadow-md rounded-lg overflow-hidden">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            @Html.DisplayNameFor(model => model.PurchaseRequest.ItemName)
                        </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      @Html.DisplayNameFor(model => model.Quantity)
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      @Html.DisplayNameFor(model => model.UnitPrice)
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      @Html.DisplayNameFor(model => model.TotalPrice)
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      @Html.DisplayNameFor(model => model.ReceivedBy.UserName)
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      @Html.DisplayNameFor(model => model.ReceivedDate)
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      @Html.DisplayNameFor(model => model.Status)
                  </th>
              </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
              @foreach (var item in Model)
              {
                  <tr>
                      <td class="px-6 py-4 whitespace-nowrap">
                          @Html.DisplayFor(modelItem => item.PurchaseRequest.ItemName)
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                          @Html.DisplayFor(modelItem => item.Quantity)
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                          @Html.DisplayFor(modelItem => item.UnitPrice)
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                          @Html.DisplayFor(modelItem => item.TotalPrice)
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                          @Html.DisplayFor(modelItem => item.ReceivedBy.UserName)
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                          @Html.DisplayFor(modelItem => item.ReceivedDate)
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                          @Html.DisplayFor(modelItem => item.Status)
                      </td>
                  </tr>
              }
          </tbody>
      </table>
  </div>

