@model (PurchaseOrderManagementSystem.Models.Auction Auction, List<PurchaseOrderManagementSystem.Models.Bid> Bids)

  @{
  ViewData["Title"] = "Procurement Officer - View Auction";
  Layout = "_Layout";

  Func<string, string> GetAuctionStatusColor = status =>
    {
    return status switch
    {
    "open" => "bg-green-100 text-green-800",
    "closed" => "bg-red-100 text-red-800",
    "cancelled" => "bg-gray-100 text-gray-800",
    _ => "bg-gray-100 text-gray-800"
    };
    };

    Func<string, string> GetBidStatusColor = status =>
      {
      return status switch
      {
      "open" => "bg-green-100 text-green-800",
      "closed" => "bg-red-100 text-red-800",
      "won" => "bg-blue-100 text-blue-800",
      "lost" => "bg-yellow-100 text-yellow-800",
      _ => "bg-gray-100 text-gray-800"
      };
      };
      }

      <div class="min-h-screen bg-gray-50">
        <header class="bg-white shadow-sm border-b">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center py-4">
              <a href="/ProcurementOfficer"
                class="inline-flex items-center bg-transparent hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
                  stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to Approved Requests
              </a>
              <h1 class="text-2xl font-bold text-gray-900 ml-4">Auction Details & Bids</h1>
            </div>
          </div>
        </header>

        <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
          <div class="px-4 py-6 sm:px-0">
            <div class="bg-white shadow rounded-lg">
              <div class="border-b px-4 py-3">
                <h2 class="text-lg font-semibold text-gray-800">Auction Information</h2>
              </div>
              <div class="p-6 space-y-4">
                <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-8">
                  <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Item Name</dt>
                    <dd class="mt-1 text-lg text-gray-900">@Model.Auction.PurchaseRequest?.existingItem?.ItemName</dd>
                  </div>
                  <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Quantity</dt>
                    <dd class="mt-1 text-lg text-gray-900">@Model.Auction.PurchaseRequest?.quantity</dd>
                  </div>
                  <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Auction End Date</dt>
                    <dd class="mt-1 text-lg text-gray-900">@Model.Auction.EndDate.ToString("yyyy-MM-dd HH:mm")
                    </dd>
                  </div>
                  <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Auction Status</dt>
                    <dd class="mt-1 text-lg text-gray-900">
                      <span
                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetAuctionStatusColor(Model.Auction.Status.ToString().ToLower())">
                        @Model.Auction.Status
                      </span>
                    </dd>
                  </div>
                </dl>

                @if (Model.Auction.Status == PurchaseOrderManagementSystem.Models.AuctionStatus.Closed ||
                Model.Auction.Status == PurchaseOrderManagementSystem.Models.AuctionStatus.Cancelled)
                {
                <div class="mt-6 p-4 bg-gray-100 rounded-md text-gray-700">
                  This auction is @Model.Auction.Status.ToString().ToLower().
                  @if (Model.Auction.Status == PurchaseOrderManagementSystem.Models.AuctionStatus.Closed &&
                  Model.Bids.Any(b => b.Status == BidStatus.Won))
                  {
                  var winningBid = Model.Bids.FirstOrDefault(b => b.Status == BidStatus.Won);
                  <p>Winning Bid: @winningBid?.Price.ToString("C") from @winningBid?.Supplier?.BusinessName</p>
                  }
                </div>
                }
                <div class="mt-6 flex justify-end space-x-3">
                  <a asp-action="EditAuctionDeadlines" asp-route-id="@Model.Auction.Id"
                    class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Edit Deadlines
                  </a>
                  <a asp-action="ManageBids" asp-route-id="@Model.Auction.Id"
                    class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Manage Bids
                  </a>
                </div>
              </div>
            </div>

            <div class="bg-white shadow rounded-lg mt-8">
              <div class="border-b px-4 py-3">
                <h2 class="text-lg font-semibold text-gray-800">Submitted Bids</h2>
              </div>
              <div class="p-6">
                @if (Model.Bids != null && Model.Bids.Any())
                {
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                      <tr>
                        <th scope="col"
                          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Supplier
                        </th>
                        <th scope="col"
                          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Price
                        </th>
                        <th scope="col"
                          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Status
                        </th>
                        <th scope="col"
                          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                          Bid Date
                        </th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      @foreach (var bid in Model.Bids.OrderBy(b => b.Price))
                      {
                      <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                          @bid.Supplier?.BusinessName
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                          @bid.Price.ToString("C")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetBidStatusColor(bid.Status.ToString().ToLower())">
                            @bid.Status
                          </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                          @bid.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                      </tr>
                      }
                    </tbody>
                  </table>
                </div>
                }
                else
                {
                <p class="text-gray-500">No bids have been submitted for this auction yet.</p>
                }
              </div>
            </div>
          </div>
        </main>
      </div>

      @section Scripts {
      <partial name="_ValidationScriptsPartial" />
      }
