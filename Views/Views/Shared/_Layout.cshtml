<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>@ViewData["Title"] - Upper Awash Agro Industry Enterprise</title>
  <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<body class="font-sans bg-gray-100 text-gray-900">
  <header class="bg-blue-600 text-white p-4 shadow-md flex justify-between items-center">
    <h1 class="text-2xl font-bold">Upper Awash Agro Industry Enterprise</h1>
    <nav>
      <ul class="flex space-x-4">
        @if (User.Identity.IsAuthenticated) {
        @* Supply role *@
        @if (User.IsInRole("Supply"))
        {
        <li><a asp-controller="Supply" asp-action="Items" class="hover:underline">Items</a></li>
        <li><a asp-controller="Supply" asp-action="Requests" class="hover:underline">Requests</a></li>
        }
        @* Budget role *@
        @if (User.IsInRole("Budget"))
        {
        <li><a asp-controller="Budget" asp-action="Requests" class="hover:underline">Requests</a></li>
        }
        @* GM role *@
        @if (User.IsInRole("GM"))
        {
        <li><a asp-controller="GM" asp-action="Requests" class="hover:underline">Requests</a></li>
        }
        @* Procurement role *@
        @if (User.IsInRole("Procurement"))
        {
        <li><a asp-controller="Proc" asp-action="Auctions" class="hover:underline">Auctions</a></li>
        }
        @* Supplier role *@
        @if (User.IsInRole("Supplier"))
        {
        <li><a asp-controller="Supplier" asp-action="Auctions" class="hover:underline">Auctions</a></li>
        }
        @* Admin role *@
        @if (User.IsInRole("Admin"))
        {
        <li><a asp-controller="Admin" asp-action="Users" class="hover:underline">Users</a></li>
        <li><a asp-controller="Admin" asp-action="Suppliers" class="hover:underline">Suppliers</a></li>
        }

        <li>
          <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
            <button type="submit"
              class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">Logout</button>
          </form>
        </li>
        }
        else
        {
        <li><a asp-controller="Account" asp-action="Register" class="hover:underline">Register</a></li>
        <li><a asp-controller="Account" asp-action="Login" class="hover:underline">Login</a></li>
        }
      </ul>
    </nav>
  </header>

  <section class="p-4">
    @if (TempData["SuccessMessage"] != null)
    {
    <div class="flash-success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4"
      role="alert">
      <span class="block sm:inline">@TempData["SuccessMessage"]</span>
    </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
    <div class="flash-error bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
      <span class="block sm:inline">@TempData["ErrorMessage"]</span>
    </div>
    }
  </section>

  <main class="container mx-auto p-4">
    @RenderBody()
  </main>

  @RenderSection("Scripts", required: false)
</body>

</html>
