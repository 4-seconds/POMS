@model PurchaseOrderManagementSystem.Models.Supplier

@{
ViewData["Title"] = "Admin - Register Supplier";
Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center py-4">
        <a href="/Admin/PendingSuppliers"
          class="inline-flex items-center bg-transparent hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Pending Suppliers
        </a>
        <h1 class="text-2xl font-bold text-gray-900 ml-4">Register New Supplier</h1>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white shadow rounded-lg">
        <div class="border-b px-4 py-2">
          <h2 class="text-lg font-semibold">Supplier Details</h2>
        </div>
        <div class="p-4">
          <form asp-controller="Admin" asp-action="RegisterSupplier" method="post" class="space-y-4">
            <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

            <!-- ApplicationUser fields (for creating the associated user account) -->
            <h3 class="text-lg font-semibold text-gray-800 mt-6 mb-4">User Account Details</h3>
            <div>
              <label for="user_Email" class="block text-sm font-medium text-gray-700">Email</label>
              <input id="user_Email" name="user.Email" type="email"
                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label for="user_FirstName" class="block text-sm font-medium text-gray-700">First Name</label>
              <input id="user_FirstName" name="user.FirstName"
                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label for="user_LastName" class="block text-sm font-medium text-gray-700">Last Name</label>
              <input id="user_LastName" name="user.LastName"
                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label for="user_Address" class="block text-sm font-medium text-gray-700">Address</label>
              <input id="user_Address" name="user.Address"
                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label for="user_Password" class="block text-sm font-medium text-gray-700">Password</label>
              <input id="user_Password" name="user.PasswordHash" type="password"
                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span class="text-red-600 text-sm"></span>
            </div>

            <!-- Supplier fields -->
            <h3 class="text-lg font-semibold text-gray-800 mt-6 mb-4">Supplier Company Details</h3>
            <div>
              <label asp-for="BusinessName" class="block text-sm font-medium text-gray-700"></label>
              <input asp-for="BusinessName" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span asp-validation-for="BusinessName" class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700"></label>
              <input asp-for="PhoneNumber" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span asp-validation-for="PhoneNumber" class="text-red-600 text-sm"></span>
            </div>

            <button type="submit"
              class="w-full inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
              Register Supplier
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
