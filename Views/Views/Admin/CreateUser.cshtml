@model PurchaseOrderManagementSystem.Models.ApplicationUser

@{
ViewData["Title"] = "Admin - Create User";
Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center py-4">
        <a href="/Admin"
          class="inline-flex items-center bg-transparent hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to User Management
        </a>
        <h1 class="text-2xl font-bold text-gray-900 ml-4">Create New User</h1>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white shadow rounded-lg">
        <div class="border-b px-4 py-2">
          <h2 class="text-lg font-semibold">User Details</h2>
        </div>
        <div class="p-4">
          <form asp-controller="Admin" asp-action="CreateUser" method="post" class="space-y-4">
            <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

            <div>
              <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
              <input asp-for="Email" type="email" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm"
                required />
              <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label asp-for="FirstName" class="block text-sm font-medium text-gray-700"></label>
              <input asp-for="FirstName" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span asp-validation-for="FirstName" class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label asp-for="LastName" class="block text-sm font-medium text-gray-700"></label>
              <input asp-for="LastName" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span asp-validation-for="LastName" class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label for="Password" class="block text-sm font-medium text-gray-700">Password</label>
              <input id="Password" name="Password" type="password"
                class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required />
              <span class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label for="role" class="block text-sm font-medium text-gray-700">Role</label>
              <select id="role" name="role" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm" required>
                <option value="">Select a role</option>
                @foreach (var role in ViewBag.Roles)
                {
                <option value="@role">@role</option>
                }
              </select>
              <span class="text-red-600 text-sm"></span>
            </div>
            <button type="submit"
              class="w-full inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
              Create User
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
