<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>@ViewData["Title"] - Upper Awash Agro Industry</title>
  <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
  <style>
    * {
      border-color: hsl(0 0% 89.8%);
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool shouldShowSidebar = User.Identity.IsAuthenticated &&
                            !(currentController == "Home" && currentAction == "Index") &&
                            !(currentController == "Account" && (currentAction == "Login" || currentAction == "Register" || currentAction == "ForgotPassword" || currentAction == "ResetPassword" || currentAction == "ConfirmEmail")) ;
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>@ViewData["Title"] - Upper Awash Agro Industry</title>
  <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
  <style>
    * {
      border-color: hsl(0 0% 89.8%);
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<body class="font-sans bg-white text-gray-900">
  <header class="px-4 py-2 flex bg-gray-200 justify-between items-center">
    <a href="/">
      <h1 class="text-xl font-semibold">Upper Awash Agro Industry</h1>
    </a>
    <nav>
      <ul class="flex space-x-4 items-center">
        @if (User.Identity.IsAuthenticated) {
        @* Supply Logistics role *@
        <li>
          <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
            <button type="submit"
              class="bg-red-500 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded">Logout</button>
          </form>
        </li>
        }
        else
        {
        <li><a asp-controller="Account" asp-action="Login" class="bg-red-500 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded">Login</a></li>
        }
      </ul>
    </nav>
  </header>

  <div class="flex">
    @if (shouldShowSidebar)
    {
    <aside class="w-64 shrink-0 bg-gray-200 p-4 min-h-screen">
      <nav>
        <ul class="space-y-2">
          @if (User.Identity.IsAuthenticated) {
            @* Supply Logistics role *@
            @if (User.IsInRole("SupplyLogistics"))
            {
            <li><a asp-controller="SupplyLogistics" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="SupplyLogistics" asp-action="Items" class="block hover:bg-black/10 p-2 rounded">Items</a></li>
            <li><a asp-controller="SupplyLogistics" asp-action="Requests" class="block hover:bg-black/10 p-2 rounded">Requests</a></li>
            }
            @* Budget role *@
            @if (User.IsInRole("Budget"))
            {
            <li><a asp-controller="Budget" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="Budget" asp-action="Requests" class="block hover:bg-black/10 p-2 rounded">Requests</a></li>
            }
            @* General Manager role *@
            @if (User.IsInRole("GeneralManager"))
            {
            <li><a asp-controller="GeneralManager" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="GeneralManager" asp-action="Requests" class="block hover:bg-black/10 p-2 rounded">Requests</a></li>
            }
            @* Procurement Officer role *@
            @if (User.IsInRole("ProcurementOfficer"))
            {
            <li><a asp-controller="ProcurementOfficer" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="AllAuctions" class="block hover:bg-black/10 p-2 rounded">Auctions</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="MyPurchaseOrders" class="block hover:bg-black/10 p-2 rounded">Purchase Orders</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="ReceivedGoods" class="block hover:bg-black/10 p-2 rounded">Received Goods</a></li>
            }
            @* Supplier role *@
            @if (User.IsInRole("Supplier"))
            {
            <li><a asp-controller="Supplier" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="Supplier" asp-action="ActiveAuctions" class="block hover:bg-black/10 p-2 rounded">Active Auctions</a></li>
            <li><a asp-controller="Supplier" asp-action="MyBids" class="block hover:bg-black/10 p-2 rounded">My Bids</a></li>
            <li><a asp-controller="Supplier" asp-action="MyPurchaseOrders" class="block hover:bg-black/10 p-2 rounded">Purchase Orders</a></li>
            <li><a asp-controller="Supplier" asp-action="Transactions" class="block hover:bg-black/10 p-2 rounded">Transactions</a></li>
            }
            @* Admin role *@
            @if (User.IsInRole("Admin"))
            {
            <li><a asp-controller="Admin" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="Admin" asp-action="ManageUsers" class="block hover:bg-black/10 p-2 rounded">Users</a></li>
            <li><a asp-controller="Admin" asp-action="ManageSuppliers" class="block hover:bg-black/10 p-2 rounded">Suppliers</a></li>
            }

            <li><a asp-controller="Profile" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Profile</a></li>
          }
        </ul>
      </nav>
    </aside>
    }

    <div class="flex-1 ">
      @if (TempData["SuccessMessage"] != null)
      {
      <section class="p-4 bg-white">
        <div class="flash-success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4"
          role="alert">
          <span class="block sm:inline">@TempData["SuccessMessage"]</span>
        </div>
      </section>
      }
      @if (TempData["ErrorMessage"] != null)
      {
      <section class="p-4">
        <div class="flash-error bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
          <span class="block sm:inline">@TempData["ErrorMessage"]</span>
        </div>
      </section>
      }

      <main class="bg-white">
        @RenderBody()
      </main>
    </div>
  </div>

  @RenderSection("Scripts", required: false)
</body>

</html>
