<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>@ViewData["Title"] - Upper Awash Agro Industry</title>
  <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <style>
    * {
      border-color: hsl(0 0% 89.8%);
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool shouldShowSidebar = User.Identity.IsAuthenticated &&
                            !(currentController == "Home" && currentAction == "Index") &&
                            !(currentController == "Account" && (currentAction == "Login" || currentAction == "Register" || currentAction == "ForgotPassword" || currentAction == "ResetPassword" || currentAction == "ConfirmEmail" || currentAction == "ForgotPasswordConfirmation")) ;
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>@ViewData["Title"] - Upper Awash Agro Industry</title>
  <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <style>
*{
  font-family: 'Geist', sans-serif;
}
    * {
      border-color: hsl(0 0% 89.8%);
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<body class="font-sans bg-white text-gray-900">

  <div class="flex">
    @if (shouldShowSidebar)
    {
    <aside class="w-64 shrink-0 bg-gray-200 p-4 min-h-screen">
      <nav>
        <ul class="space-y-2">
          @if (User.Identity.IsAuthenticated) {
            @* Supply Logistics role *@
            @if (User.IsInRole("SupplyLogistics"))
            {
            <li><a asp-controller="SupplyLogistics" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="SupplyLogistics" asp-action="Requests" class="block hover:bg-black/10 p-2 rounded">Requests</a></li>
            <li><a asp-controller="SupplyLogistics" asp-action="CreateRequest" class="block hover:bg-black/10 p-2 rounded">Create Request</a></li>
            }
            @* Budget role *@
            @if (User.IsInRole("Budget"))
            {
            <li><a asp-controller="Budget" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            }
            @* General Manager role *@
            @if (User.IsInRole("GeneralManager"))
            {
            <li><a asp-controller="GeneralManager" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="GeneralManager" asp-action="Requests" class="block hover:bg-black/10 p-2 rounded">Requests</a></li>
            }
            @* Procurement Officer role *@
            @if (User.IsInRole("ProcurementOfficer"))
            {
            <li><a asp-controller="ProcurementOfficer" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="ApprovedPurchaseRequests" class="block hover:bg-black/10 p-2 rounded">Requests</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="ActiveAuctions" class="block hover:bg-black/10 p-2 rounded">Active Auctions</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="ArchivedAuctions" class="block hover:bg-black/10 p-2 rounded">Archived Auctions</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="MyPurchaseOrders" class="block hover:bg-black/10 p-2 rounded">Purchase Orders</a></li>
            <li><a asp-controller="ProcurementOfficer" asp-action="ReceivedGoods" class="block hover:bg-black/10 p-2 rounded">Received Goods</a></li>
            }
            @* Supplier role *@
            @if (User.IsInRole("Supplier"))
            {
            <li><a asp-controller="Supplier" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="Supplier" asp-action="ActiveAuctions" class="block hover:bg-black/10 p-2 rounded">Active Auctions</a></li>
            <li><a asp-controller="Supplier" asp-action="MyBids" class="block hover:bg-black/10 p-2 rounded">My Bids</a></li>
            <li><a asp-controller="Supplier" asp-action="MyPurchaseOrders" class="block hover:bg-black/10 p-2 rounded">Purchase Orders</a></li>
            <li><a asp-controller="Supplier" asp-action="Transactions" class="block hover:bg-black/10 p-2 rounded">Transactions</a></li>
            <li><a asp-controller="Supplier" asp-action="Settings" class="block hover:bg-black/10 p-2 rounded">Settings</a></li>
            }
            @* Admin role *@
            @if (User.IsInRole("Admin"))
            {
            <li><a asp-controller="Admin" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Dashboard</a></li>
            <li><a asp-controller="Admin" asp-action="ManageUsers" class="block hover:bg-black/10 p-2 rounded">Users</a></li>
            <li><a asp-controller="Admin" asp-action="ManageSuppliers" class="block hover:bg-black/10 p-2 rounded">Suppliers</a></li>
            }

            <li><a asp-controller="Profile" asp-action="Index" class="block hover:bg-black/10 p-2 rounded">Profile</a></li>
          }
        </ul>
      </nav>
    </aside>
    }

    <div class="flex-1 @(shouldShowSidebar ? "max-w-[calc(100vw-256px)]" : "")">

  <header class="p-4 flex bg-white border-b justify-between items-center">
    <a href="/">
      <h1 class="text-xl font-semibold">Upper Awash Agro Industry</h1>
    </a>
    <nav>
      <ul class="flex space-x-4 items-center">
        @if (User.Identity.IsAuthenticated) {
        @* Supply Logistics role *@
        <li>
          <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
            <button type="submit"
              class="bg-red-500 hover:bg-red-700 text-sm text-white font-semibold py-1 px-4 rounded">Logout</button>
          </form>
        </li>
        }
        else
        {
        <li><a asp-controller="Account" asp-action="Login" class="bg-indigo-500 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded">Login</a></li>
        }
      </ul>
    </nav>
  </header>
      @if (TempData["SuccessMessage"] != null)
      {
      <section class="p-4 bg-white">
        <div class="flash-success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4"
          role="alert">
          <span class="block sm:inline">@TempData["SuccessMessage"]</span>
        </div>
      </section>
      }
      @if (TempData["ErrorMessage"] != null)
      {
      <section class="p-4">
        <div class="flash-error bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
          <span class="block sm:inline">@TempData["ErrorMessage"]</span>
        </div>
      </section>
      }

      <main class="bg-white">
        @RenderBody()
      </main>
    </div>
  </div>

  @RenderSection("Scripts", required: false)
</body>

</html>
