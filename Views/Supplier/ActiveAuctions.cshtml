@model List<PurchaseOrderManagementSystem.Models.Auction>

@{
    ViewData["Title"] = "Supplier - Active Auctions";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50">
    <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center py-4">
                <h1 class="text-2xl font-bold text-gray-900">Active Auctions</h1>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
            @if (!Model.Any())
            {
                <div class="text-center py-12">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No active auctions</h3>
                    <p class="mt-1 text-sm text-gray-500">There are currently no active auctions.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var auction in Model)
                    {
                        <div class="bg-white overflow-hidden shadow rounded-lg">
                            <div class="p-5">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                    </div>
                                    <div class="ml-5 w-0 flex-1">
                                        <dl>
                                            <dt class="text-sm font-medium text-gray-500 truncate">Item Name</dt>
                                            <dd class="text-lg font-medium text-gray-900">@auction.PurchaseRequest?.existingItem?.ItemName</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                            <div class="bg-gray-50 px-5 py-3">
                                <div class="text-sm">
                                    <div class="flex justify-between">
                                        <span class="text-gray-500">Quantity:</span>
                                        <span class="text-gray-900">@auction.PurchaseRequest?.quantity</span>
                                    </div>
                                    <div class="flex justify-between mt-2">
                                        <span class="text-gray-500">End Date:</span>
                                        <span class="text-gray-900">@auction.EndDate.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                    <div class="flex justify-between mt-2">
                                        <span class="text-gray-500">Delivery Deadline:</span>
                                        <span class="text-gray-900">@auction.DeliveryDeadline.ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div class="flex justify-between mt-2">
                                        <span class="text-gray-500">Status:</span>
                                        <span class="@(auction.Status == AuctionStatus.Open ? "text-green-600" : "text-red-600")">
                                            @auction.Status
                                        </span>
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <a href="/Supplier/ViewAuction/@auction.Id"
                                       class="w-full flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </main>
</div> 