@model IEnumerable<PurchaseOrderManagementSystem.Models.PurchaseOrder>

@{
    ViewData["Title"] = "My Purchase Orders";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50">
    <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center py-4">
                <a asp-action="Index" class="text-blue-600 hover:text-blue-800">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                    </svg>
                </a>
                <h1 class="text-2xl font-bold text-gray-900 ml-4">My Purchase Orders</h1>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="bg-white shadow rounded-lg">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Unit Price</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Price</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var po in Model)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@po.OrderId</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@po.PurchaseRequest?.existingItem?.ItemName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@po.Quantity @po.Unit</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@po.UnitPrice.ToString("C")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@po.TotalPrice.ToString("C")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@po.OrderDate.ToString("yyyy-MM-dd")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                        @(po.Status == "Pending" ? "bg-yellow-100 text-yellow-800" :
                                          po.Status == "Ready for Pickup" ? "bg-green-100 text-green-800" :
                                          po.Status == "Delivered" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-800")">
                                        @po.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    @if (po.Status == "Pending")
                                    {
                                        <form asp-action="UpdatePurchaseOrderStatus" method="post" style="display: inline;">
                                            <input type="hidden" name="id" value="@po.OrderId" />
                                            <input type="hidden" name="status" value="Ready for Pickup" />
                                            <button type="submit" class="text-green-600 hover:text-green-900">Mark as Ready</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div> 