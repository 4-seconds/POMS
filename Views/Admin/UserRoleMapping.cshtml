@using Microsoft.AspNetCore.Identity
@model Tuple<List<PurchaseOrderManagementSystem.Models.ApplicationUser>, List<IdentityRole>, Dictionary<string,
List<string> >>

@{
    ViewData["Title"] = "User Role Mapping";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">User Role Mapping</h2>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form method="post" action="@Url.Action("AssignRole", "Admin")">
                        <div class="mb-3">
                            <label for="UserId" class="form-label">Select User</label>
                            <select class="form-select" id="UserId" name="UserId" required>
                                <option value="" disabled selected>-- Select a User --</option>
                                @foreach (var user in Model.Item1)
                                {
                                    <option value="@user.Id">@user.UserName (@user.Email)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="RoleId" class="form-label">Select Role</label>
                            <select class="form-select" id="RoleId" name="RoleId" required>
                                <option value="" disabled selected>-- Select a Role --</option>
                                @foreach (var role in Model.Item2)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            </select>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Assign Role</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h3 class="text-center">User Role List</h3>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Item1)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Email</td>

                            <td>
                                @if (Model.Item3.ContainsKey(user.Id))
                                {
                                    @string.Join(", ", Model.Item3[user.Id])
                                }
                                else
                                {
                                    <span>No Roles Assigned</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
