@{
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
    ViewData["Title"] = "User Management";
}

<style>
    .card {
        background-color: #fdf6e3;
        /* Creamy background color */
        border: 1px solid #f5e6cc;
        /* Light border for a subtle effect */
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 10px;
        /* Rounded corners */
    }

    .card:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    .card-body i {
        font-size: 3rem;
    }

    .btn {
        font-weight: bold;
        letter-spacing: 0.5px;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .card-text {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

<div class="container mt-4 d-flex justify-content-center align-items-center flex-column">
    <h2 class="mb-4 text-center">User Management</h2>
    <div class="row g-4 justify-content-center">
        <!-- User List Card -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-users mb-3 text-primary"></i>
                    <h5 class="card-title">User List</h5>
                    <p class="card-text">View and manage registered users.</p>
                    <a href="@Url.Action("UserLists", "Admin")" class="btn btn-primary btn-sm">Go</a>
                </div>
            </div>
        </div>

        <!-- Role List Card -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-user-tag mb-3 text-success"></i>
                    <h5 class="card-title">Role List</h5>
                    <p class="card-text">Manage available user roles.</p>
                    <a href="@Url.Action("UserRoleLists", "Admin")" class="btn btn-success btn-sm">Go</a>
                </div>
            </div>
        </div>

        <!-- User-Role Mapping Card -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-link mb-3 text-warning"></i>
                    <h5 class="card-title">User-Role Mapping</h5>
                    <p class="card-text">Assign roles to users.</p>
                    <a href="@Url.Action("UserRoleMapping", "Admin")" class="btn btn-warning btn-sm">Go</a>
                </div>
            </div>
        </div>

        <!-- Ban User Card -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-user-slash mb-3 text-danger"></i>
                    <h5 class="card-title">Ban User</h5>
                    <p class="card-text">Restrict user access.</p>
                    <a href="#" class="btn btn-danger btn-sm">Go</a>
                </div>
            </div>
        </div>
    </div>
</div>