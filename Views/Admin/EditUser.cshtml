@model PurchaseOrderManagementSystem.Models.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
        <div class="bg-white shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900">Edit User</h3>
                <div class="mt-2 max-w-xl text-sm text-gray-500">
                    <p>Edit the details of an existing user account.</p>
                </div>
                <form asp-action="EditUser" method="post" class="mt-5 space-y-6">
                    <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

                    <input type="hidden" asp-for="Id" />

                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="FirstName"
                               class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" />
                        <span asp-validation-for="FirstName" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="LastName"
                               class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" />
                        <span asp-validation-for="LastName" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Email" type="email"
                               class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" />
                        <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="PhoneNumber" type="tel"
                               class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" />
                        <span asp-validation-for="PhoneNumber" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="BranchId" class="block text-sm font-medium text-gray-700"></label>
                        <select asp-for="BranchId" asp-items="@(new SelectList(ViewBag.Branches, "Id", "BranchName"))"
                                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500">
                            <option value="">-- Select Branch --</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="AccountStatus" class="block text-sm font-medium text-gray-700"></label>
                        <select asp-for="AccountStatus" asp-items="Html.GetEnumSelectList<PurchaseOrderManagementSystem.Models.AccountStatus>()"
                                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"></select>
                        <span asp-validation-for="AccountStatus" class="text-red-600 text-sm"></span>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="PasswordResetRequired" type="checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded" />
                        <label asp-for="PasswordResetRequired" class="ml-2 block text-sm text-gray-900"></label>
                    </div>

                    <div class="flex justify-end">
                        <a asp-action="ManageUsers"
                           class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Cancel
                        </a>
                        <button type="submit"
                                class="ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

