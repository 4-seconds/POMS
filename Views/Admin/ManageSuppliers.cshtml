@model IEnumerable<PurchaseOrderManagementSystem.Models.Supplier>

@{
    ViewData["Title"] = "Manage Suppliers";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center py-4">
                <!-- Back to Dashboard Button -->
                <a asp-action="Index" asp-controller="Admin">
                    <button type="button"
                        class="inline-flex items-center px-2 py-1 text-sm font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-100 rounded">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to Dashboard
                    </button>
                </a>
                <h1 class="text-2xl font-bold text-gray-900 ml-4">Manage Suppliers</h1>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
            <div class="bg-white shadow rounded-lg">
                <!-- Card Header -->
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <h2 class="text-lg font-semibold text-gray-800">All Suppliers</h2>
                </div>

                <!-- Card Content / Table -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <!-- Table Head -->
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Business Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact Person</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone Number</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <!-- Table Body -->
                        <tbody class="bg-white divide-y divide-gray-200">
                            @if (Model.Any())
                            {
                                foreach (var supplier in Model)
                                {
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">@supplier.BusinessName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@supplier.User.FirstName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@supplier.User.Email</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@supplier.PhoneNumber</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                                                @(supplier.Status == PurchaseOrderManagementSystem.Models.SupplierStatus.Active ? "bg-green-100 text-green-800" :
                                                  supplier.Status == PurchaseOrderManagementSystem.Models.SupplierStatus.Inactive ? "bg-yellow-100 text-yellow-800" : "bg-red-100 text-red-800")">
                                                @supplier.Status
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-left text-sm font-medium">
                                            <a asp-action="ViewSupplier" asp-route-id="@supplier.Id" class="text-blue-600 hover:text-blue-900 mr-4">View</a>
                                            @if (supplier.Status == PurchaseOrderManagementSystem.Models.SupplierStatus.Inactive)
                                            {
                                                <form asp-action="ApproveSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-green-600 hover:text-green-900 mr-2">Approve</button>
                                                </form>
                                                <form asp-action="RejectSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-red-600 hover:text-red-900">Reject</button>
                                                </form>
                                            }
                                            else if (supplier.Status == PurchaseOrderManagementSystem.Models.SupplierStatus.Active)
                                            {
                                                <form asp-action="SuspendSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-yellow-600 hover:text-yellow-900">Suspend</button>
                                                </form>
                                            }
                                            else if (supplier.Status == PurchaseOrderManagementSystem.Models.SupplierStatus.Suspended)
                                            {
                                                <form asp-action="ApproveSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-green-600 hover:text-green-900">Activate</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-4 text-center text-gray-500">
                                        No suppliers found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

