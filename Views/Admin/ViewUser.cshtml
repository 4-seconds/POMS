@using Microsoft.AspNetCore.Identity
@model dynamic

@{
ViewData["Title"] = "User Details";
Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <!-- Header -->
      <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg leading-6 font-medium text-gray-900">User Details</h3>
            <p class="mt-1 max-w-2xl text-sm text-gray-500">Detailed information about the user account.</p>
          </div>
          <div class="flex space-x-3">
            <a asp-action="EditUser" asp-route-id="@ViewBag.User.Id"
              class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              <svg class="-ml-1 mr-2 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                fill="currentColor">
                <path
                  d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
              </svg>
              Edit User
            </a>
            <a asp-action="EditUserRoles" asp-route-id="@ViewBag.User.Id"
              class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              <svg class="-ml-1 mr-2 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                fill="currentColor">
                <path
                  d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
              </svg>
              Edit Roles
            </a>
            <a asp-action="ManageUsers"
              class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              <svg class="-ml-1 mr-2 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                fill="currentColor">
                <path fill-rule="evenodd"
                  d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                  clip-rule="evenodd" />
              </svg>
              Back to Users
            </a>
          </div>
        </div>
      </div>

      <!-- User Information -->
      <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
        <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Full Name</dt>
            <dd class="mt-1 text-sm text-gray-900">@ViewBag.User.FirstName @ViewBag.User.LastName</dd>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Username</dt>
            <dd class="mt-1 text-sm text-gray-900">@ViewBag.User.UserName</dd>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Email</dt>
            <dd class="mt-1 text-sm text-gray-900">@ViewBag.User.Email</dd>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Phone Number</dt>
            <dd class="mt-1 text-sm text-gray-900">@(string.IsNullOrEmpty(ViewBag.User.PhoneNumber) ? "N/A" : ViewBag.User.PhoneNumber)</dd>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Branch</dt>
            <dd class="mt-1 text-sm text-gray-900">@(ViewBag.User.Branch != null ? ViewBag.User.Branch.BranchName : "N/A")</dd>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Account Status</dt>
            <dd class="mt-1">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                @(ViewBag.User.AccountStatus == AccountStatus.Active ? " bg-green-100 text-green-800" :
                ViewBag.User.AccountStatus==AccountStatus.Pending ? "bg-yellow-100 text-yellow-800"
                : "bg-red-100 text-red-800" )">
                @ViewBag.User.AccountStatus
              </span>
            </dd>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Password Reset Required</dt>
            <dd class="mt-1 text-sm text-gray-900">@(ViewBag.User.PasswordResetRequired ? "Yes" : "No")</dd>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Roles</dt>
            <dd class="mt-1">
              @foreach (var role in ViewBag.UserRoles)
              {
              <span
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mr-2">
                @role
              </span>
              }
            </dd>
          </div>

        </dl>
      </div>

      <!-- Supplier Information (if applicable) -->
      @if (ViewBag.Supplier != null)
      {
      <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
        <h4 class="text-lg font-medium text-gray-900 mb-4">Supplier Account Information</h4>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500 mb-4">This user has a supplier account. Click below to view the supplier
            details.</p>
          <a asp-action="ViewSupplier" asp-route-id="@ViewBag.Supplier.Id"
            class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
              <path fill-rule="evenodd"
                d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z"
                clip-rule="evenodd" />
            </svg>
            View Supplier Details
          </a>
        </div>
      </div>
      }

      <!-- Account Actions -->
      <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
        <div class="flex justify-end space-x-3">
          <form asp-action="DeleteUser" asp-route-id="@ViewBag.User.Id" method="post" class="inline"
            onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit"
              class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
              <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                fill="currentColor">
                <path fill-rule="evenodd"
                  d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                  clip-rule="evenodd" />
              </svg>
              Delete User
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
