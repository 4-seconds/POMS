@using PurchaseOrderManagementSystem.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
    var usersWithRoles = ViewBag.UsersWithRoles as List<(ApplicationUser User, IList<string> Roles)>;
    var suppliers = ViewBag.Suppliers as List<Supplier>;
}

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between py-4">
                <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="px-4 py-6 sm:px-0">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                                <!-- Link to Manage Branches -->
                                <div class="bg-white overflow-hidden shadow rounded-lg">
                                    <div class="p-5">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 bg-blue-500 rounded-md p-3">
                                                <svg class="h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m-1 4h1m4-4h1m-1 4h1m-5 4v-4h4v4h-4z" />
                                                </svg>
                                            </div>
                                            <div class="ml-5 w-0 flex-1">
                                                <dl>
                                                    <dt class="text-sm font-medium text-gray-500 truncate">Manage Branches</dt>
                                                    <dd class="flex items-baseline">
                                                        <div class="text-2xl font-semibold text-gray-900">
                                                            @* You can display a count of branches here if desired, e.g., @ViewBag.BranchCount.  For now, just a link. *@
                                                        </div>
                                                    </dd>
                                                </dl>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="bg-gray-50 px-5 py-3">
                                        <div class="text-sm">
                                            <a asp-action="Branches" asp-controller="Admin" class="font-medium text-blue-600 hover:text-blue-900">
                                                View all branches <span class="ml-2" aria-hidden="true">&rarr;</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
            
            <!-- Pending Supplier Management Table -->
            <div class="bg-white shadow rounded-lg mb-8">
                <!-- Card Header -->
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <h2 class="text-lg font-semibold text-gray-800">Suppliers Pending Approval</h2>
                    <a asp-action="ManageSuppliers" asp-controller="Admin">
                        <button type="button"
                            class="inline-flex items-center px-3 py-1 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700">
                            View All Suppliers
                        </button>
                    </a>
                </div>

                <!-- Card Content / Table -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <!-- Table Head -->
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Business Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone Number</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <!-- Table Body -->
                        <tbody class="bg-white divide-y divide-gray-200">
                            @{
                                var pendingSuppliers = ViewBag.PendingSuppliers as List<PurchaseOrderManagementSystem.Models.Supplier>;
                            }
                            @if (pendingSuppliers != null && pendingSuppliers.Any())
                            {
                                foreach (var supplier in pendingSuppliers)
                                {
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">@supplier.BusinessName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@supplier.PhoneNumber</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium 
                                                @(supplier.Status == PurchaseOrderManagementSystem.Models.SupplierStatus.Active ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                                @supplier.Status
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                            <a asp-action="ViewSupplier" asp-route-id="@supplier.Id" class="text-blue-600 hover:text-blue-900 mr-4">View</a>
                                            <form asp-action="ApproveSupplier" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@supplier.Id" />
                                                <button type="submit" class="text-green-600 hover:text-green-900 mr-4">Approve</button>
                                            </form>
                                            <form asp-action="RejectSupplier" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@supplier.Id" />
                                                <button type="submit" class="text-red-600 hover:text-red-900">Reject</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="px-6 py-4 text-center text-gray-500">
                                        No pending suppliers found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- User Management Table -->
            <div class="bg-white shadow rounded-lg mb-8">
                <!-- Card Header -->
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <h2 class="text-lg font-semibold text-gray-800">All System Users</h2>
                    <a asp-action="ManageUsers" asp-controller="Admin">
                        <button type="button"
                            class="inline-flex items-center px-3 py-1 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700">
                            Manage Users
                        </button>
                    </a>
                </div>

                <!-- Card Content / Table -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <!-- Table Head -->
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">First Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <!-- Table Body -->
                        <tbody class="bg-white divide-y divide-gray-200">
                            @if (usersWithRoles != null && usersWithRoles.Any())
                            {
                                foreach (var userTuple in usersWithRoles)
                                {
                                    var user = userTuple.User;
                                    var roles = userTuple.Roles;
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.Email</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.FirstName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.LastName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">
                                            @string.Join(", ", roles)
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                                                @(user.AccountStatus == AccountStatus.Active ? "bg-green-100 text-green-800" :
                                                  user.AccountStatus == AccountStatus.Pending ? "bg-yellow-100 text-yellow-800" : "bg-red-100 text-red-800")">
                                                @user.AccountStatus
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-left text-sm font-medium">
                                            <a asp-action="ViewUser" asp-route-id="@user.Id" class="text-blue-600 hover:text-blue-900 mr-4">View</a>
                                            <a asp-action="EditUserRoles" asp-route-id="@user.Id" class="text-indigo-600 hover:text-indigo-900 mr-4">Edit Roles</a>
                                            <form asp-action="DeleteUser" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="text-red-600 hover:text-red-900" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-4 text-center text-gray-500">
                                        No users found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Supplier Management Table -->
            <div class="bg-white shadow rounded-lg">
                <!-- Card Header -->
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <h2 class="text-lg font-semibold text-gray-800">All Suppliers</h2>
                    <a asp-action="ManageSuppliers" asp-controller="Admin">
                        <button type="button"
                            class="inline-flex items-center px-3 py-1 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700">
                            Manage Suppliers
                        </button>
                    </a>
                </div>

                <!-- Card Content / Table -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <!-- Table Head -->
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Business Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact Person</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone Number</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <!-- Table Body -->
                        <tbody class="bg-white divide-y divide-gray-200">
                            @if (suppliers != null && suppliers.Any())
                            {
                                foreach (var supplier in suppliers)
                                {
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-900">@supplier.BusinessName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@supplier.User.FirstName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@supplier.User.Email</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-700">@supplier.PhoneNumber</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                                                @(supplier.Status == SupplierStatus.Active ? "bg-green-100 text-green-800" :
                                                  supplier.Status == SupplierStatus.Inactive ? "bg-yellow-100 text-yellow-800" : "bg-red-100 text-red-800")">
                                                @supplier.Status
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-left text-sm font-medium">
                                            <a asp-action="ViewSupplier" asp-route-id="@supplier.Id" class="text-blue-600 hover:text-blue-900 mr-4">View</a>
                                            @if (supplier.Status == SupplierStatus.Inactive)
                                            {
                                                <form asp-action="ApproveSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-green-600 hover:text-green-900 mr-2">Approve</button>
                                                </form>
                                                <form asp-action="RejectSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-red-600 hover:text-red-900">Reject</button>
                                                </form>
                                            }
                                            else if (supplier.Status == SupplierStatus.Active)
                                            {
                                                <form asp-action="SuspendSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-yellow-600 hover:text-yellow-900">Suspend</button>
                                                </form>
                                            }
                                            else if (supplier.Status == SupplierStatus.Suspended)
                                            {
                                                <form asp-action="ApproveSupplier" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@supplier.Id" />
                                                    <button type="submit" class="text-green-600 hover:text-green-900">Activate</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-4 text-center text-gray-500">
                                        No suppliers found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
                </div>
