@{
Layout = "_Layout";
ViewData["Title"] = "Add New Item";
}
@model PurchaseOrderManagementSystem.Models.Item
<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center py-4">
        <a href="/SupplyLogistics/Items"
          class="inline-flex items-center bg-transparent hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Items
        </a>
        <h1 class="text-2xl font-bold text-gray-900 ml-4">Add New Item</h1>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white shadow rounded-lg">
        <div class="border-b px-4 py-2">
          <h2 class="text-lg font-semibold">Item Details</h2>
        </div>
        <div class="p-4">
          <form asp-controller="SupplyLogistics" asp-action="CreateItem" method="post" class="space-y-4">
            <div>
              <label asp-for="ItemName" class="block text-sm font-medium text-gray-700"></label>
              <input asp-for="ItemName"
                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"
                required />
              <span asp-validation-for="ItemName" class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label asp-for="Description" class="block text-sm font-medium text-gray-700"></label>
              <textarea asp-for="Description"
                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"></textarea>
              <span asp-validation-for="Description" class="text-red-600 text-sm"></span>
            </div>
            <div>
              <label asp-for="Unit" class="block text-sm font-medium text-gray-700"></label>
              <input asp-for="Unit" placeholder="e.g., kg, pieces, liters"
                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"
                required />
              <span asp-validation-for="Unit" class="text-red-600 text-sm"></span>
            </div>
            <button type="submit"
              class="w-full inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
              Add Item
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
