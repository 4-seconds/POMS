@model PurchaseOrderManagementSystem.Models.PurchaseRequest

@{
ViewData["Title"] = "Create Purchase Request";
}

<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center py-4">
        <a href="/SupplyLogistics/Requests"
          class="inline-flex items-center bg-transparent hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Purchase Requests
        </a>
        <h1 class="text-2xl font-bold text-gray-900 ml-4">Create Purchase Request</h1>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white shadow rounded-lg p-6">
        <form method="post" asp-action="CreateRequest" class="space-y-6">
          <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

          <div id="itemSelectSection">
            <label asp-for="ExistingItemId" class="block text-sm font-medium text-gray-700">Item</label>
            <select asp-for="ExistingItemId" id="existingItems" asp-items="ViewBag.Items"
              class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"
              required>
              <option value="">Select an item</option>
            </select>
            <span asp-validation-for="ExistingItemId" class="text-red-600 text-sm"></span>
            <button type="button" id="showNewItemFields" class="mt-2 text-blue-600 hover:underline text-sm">+ Add New Item</button>
          </div>

          <div id="newItemSection" style="display:none;">
            <div class="mb-2">
              <label class="block text-sm font-medium text-gray-700">Item Name</label>
              <input name="NewItemName" id="NewItemName" type="text" maxlength="100"
                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" />
            </div>
            <div class="mb-2">
              <label class="block text-sm font-medium text-gray-700">Description</label>
              <input name="NewItemDescription" id="NewItemDescription" type="text" maxlength="500"
                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" />
            </div>
            <div class="mb-2">
              <label class="block text-sm font-medium text-gray-700">Unit</label>
              <input name="NewItemUnit" id="NewItemUnit" type="text" maxlength="100"
                class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500" />
            </div>
            <button type="button" id="cancelNewItem" class="text-gray-600 hover:underline text-sm">Cancel</button>
            <div class="text-xs text-gray-500 mt-1">(The new item will be created with your request.)</div>
          </div>

          <div>
            <label asp-for="quantity" class="block text-sm font-medium text-gray-700">Quantity</label>
            <input asp-for="quantity" type="number" min="1"
              class="mt-1 px-3 py-1 border block w-full border-gray-300 rounded-md shadow-sm focus:outline-none focus:border-blue-500"
              required />
            <span asp-validation-for="quantity" class="text-red-600 text-sm"></span>
          </div>


          <button type="submit"
            class="w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Create Request
          </button>
        </form>
      </div>
    </div>
  </main>
</div>
<script>
$(document).ready(function() {
    $('#existingItems').select2();
    $('#showNewItemFields').on('click', function() {
        $('#itemSelectSection').hide();
        $('#newItemSection').show();
        // Remove required from select so form can submit
        $('#existingItems').prop('required', false);
    });
    $('#cancelNewItem').on('click', function() {
        $('#newItemSection').hide();
        $('#itemSelectSection').show();
        // Restore required to select
        $('#existingItems').prop('required', true);
    });
});
</script>
